# GitHub API access. A token is optional for public repositories but recommended
# for rate limits. Never commit a real token.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# Provider keys. The benchmark only calls a provider when its key is present.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model IDs are deliberately configurable so the benchmark does not hard-code
# stale aliases. Use the IDs currently available to your accounts.
OPENAI_MODEL=
ANTHROPIC_MODEL=
